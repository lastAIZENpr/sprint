<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
    version="3.1">

    <context-param>
        <param-name>controleurPackage</param-name>
        <param-value>main.java.controller</param-value>
    </context-param>

    <context-param>
        <param-name>view-prefix</param-name>
        <param-value>/WEB-INF/views/</param-value>
    </context-param>

    <context-param>
        <param-name>view-suffix</param-name>
        <param-value>.jsp</param-value>
    </context-param>

    <listener>
        <listener-class>listner.AppInitializer</listener-class>
    </listener>

    <servlet>
        <servlet-name>FrameWorkController</servlet-name>
        <servlet-class>ProcessRequest</servlet-class>
        <load-on-startup>2</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrameWorkController</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>

</web-app>
